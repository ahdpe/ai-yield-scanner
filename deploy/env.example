# LIVE credentials and limits. Never commit real values; keep this file mode 600.
# Copy to state/live_config.env and fill in placeholders.

# --- Polymarket wallet (Deposit Wallet, signature_type=3, pUSD) ---
POLY_PRIVATE_KEY=REPLACE_WITH_WALLET_PRIVATE_KEY
POLY_FUNDER_ADDRESS=REPLACE_WITH_DEPOSIT_WALLET_ADDRESS
POLY_SIGNATURE_TYPE=3

# --- Strategy limits ---
LIVE_TOTAL_DEPOSIT=1000
LIVE_SLOT_SIZE=100
LIVE_MAX_SLOTS=10

# --- Venice AI (primary) ---
VENICE_API_KEY=REPLACE_WITH_VENICE_KEY
VENICE_BASE_URL=http://127.0.0.1:8787/api/v1
VENICE_MODEL=claude-sonnet-5-5
VENICE_MODELS=claude-sonnet-5-5,grok-4-6
AI_MAX_CALLS_PER_DAY=240
AI_REAUDIT_RESERVE_CALLS=96

# --- Command Code (failover, separate budget) ---
COMMANDCODE_API_KEY=REPLACE_WITH_COMMANDCODE_KEY
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_MODELS=claude-sonnet-5-5,xai/grok-4.6
COMMANDCODE_MAX_CALLS_PER_DAY=240
COMMANDCODE_REAUDIT_RESERVE_CALLS=96
