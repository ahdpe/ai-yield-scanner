# Venice AI key. Read from the environment or, as a fallback, from ~/.hermes/.env
VENICE_API_KEY=REPLACE_WITH_YOUR_VENICE_KEY
# OpenAI-compatible endpoint: a local budget proxy or https://api.venice.ai/api/v1
VENICE_BASE_URL=http://127.0.0.1:8787/api/v1
VENICE_MODEL=gemini-4-argon
# Optional limits for paid AI calls per UTC day
AI_MAX_CALLS_PER_DAY=40
AI_REAUDIT_RESERVE_CALLS=16
