[Unit]
Description=Polymarket Live Smart Bonding Trader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=__PROJECT_DIR__/state/live_config.env
ExecStart=__PROJECT_DIR__/venv/bin/python3 __PROJECT_DIR__/live_trader.py --interval 120
ExecStopPost=/usr/bin/python3 __PROJECT_DIR__/service_exit_alert.py %n
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
